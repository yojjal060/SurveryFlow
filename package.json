{
  "name": "survey-builder",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently --names \"api,web\" --prefix-colors \"blue,magenta\" \"npm run dev --workspace=@survey-builder/api\" \"npm run dev --workspace=@survey-builder/web\"",
    "test": "npm run test --workspace=@survey-builder/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
